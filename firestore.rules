rules_version = '2';
// Ninequal leaderboard rules: anyone can read the boards; each signed-in player
// can only write their own row, and a Daily score can be posted once, never edited.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: one row per player; every board except "Daily 每天排名" is computed from it
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'tr', 'p1', 'p2', 'wk', 'p2w', 'mo', 'p2m', 'ns', 'nb',
             'dp', 'dpl', 'dwo', 'dtr', 'lf', 'dailyStreak', 'dailyBest', 'streakDay', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.tr is map && request.resource.data.tr.size() <= 9
        && request.resource.data.p1 is number && request.resource.data.p1 >= 0 && request.resource.data.p1 <= 200000
        && request.resource.data.p2 is number && request.resource.data.p2 >= 0 && request.resource.data.p2 <= 400000
        && request.resource.data.p2w is number && request.resource.data.p2w >= 0 && request.resource.data.p2w <= request.resource.data.p2
        && request.resource.data.p2m is number && request.resource.data.p2m >= 0 && request.resource.data.p2m <= request.resource.data.p2
        && request.resource.data.wk is string && request.resource.data.wk.size() == 10
        && request.resource.data.mo is string && request.resource.data.mo.size() == 7
        && request.resource.data.ns is int && request.resource.data.ns >= 0
        && request.resource.data.nb is int && request.resource.data.nb >= request.resource.data.ns && request.resource.data.nb <= 20000
        && request.resource.data.dp is int && request.resource.data.dp >= 0 && request.resource.data.dp <= 50000
        && request.resource.data.dpl is int && request.resource.data.dpl >= 0 && request.resource.data.dpl <= 10000
        && request.resource.data.dwo is int && request.resource.data.dwo >= 0 && request.resource.data.dwo <= request.resource.data.dpl
        && request.resource.data.dtr is int && request.resource.data.dtr >= 0
        && request.resource.data.lf is number && request.resource.data.lf >= 0
        && request.resource.data.dailyStreak is int && request.resource.data.dailyStreak >= 0 && request.resource.data.dailyStreak <= 5000
        && request.resource.data.dailyBest is int && request.resource.data.dailyBest >= request.resource.data.dailyStreak
        && request.resource.data.streakDay is int
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // users/{uid}/progress/{puzzle}: each player's saved puzzles, private to that player
    match /users/{uid}/progress/{pid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['g', 'c', 't', 'w', 'st', 'am'])
        && request.resource.data.g is list && request.resource.data.g.size() <= 6
        && request.resource.data.c is list && request.resource.data.c.size() == 9
        && request.resource.data.t is number && request.resource.data.t >= 0
        && request.resource.data.w is int && (request.resource.data.w == 0 || request.resource.data.w == 1)
        && request.resource.data.st is number && request.resource.data.am is number && request.resource.data.am >= 0;
    }

    // rooms/{code}: a battle between two signed-in players
    match /rooms/{code} {
      function room() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
      function player() { return request.auth != null && (request.auth.uid == room().host || request.auth.uid == room().guest); }
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'guest', 'guestName', 'bestOf', 'rule', 'at'])
        && request.resource.data.host == request.auth.uid && request.resource.data.guest == null
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 40
        && request.resource.data.bestOf in [3, 5, 7]
        && request.resource.data.rule in ['free', 'locked', 'strict']
        && request.resource.data.at == request.time;
      // the only change allowed: an empty seat taken by someone else
      allow update: if request.auth != null && resource.data.guest == null
        && request.auth.uid != resource.data.host
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'guestName'])
        && request.resource.data.guest == request.auth.uid
        && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 40;
      // eq/{round_uid}: the puzzle a player set for that round; res/{round_uid}: how that player did. Posted once, never changed.
      match /eq/{id} {
        allow read: if player();
        allow create: if player() && request.resource.data.keys().hasOnly(['by', 'r', 'eq'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.r is int && request.resource.data.r >= 1 && request.resource.data.r <= 60
          && id == string(request.resource.data.r) + '_' + request.auth.uid
          && request.resource.data.eq is string && request.resource.data.eq.size() == 9;
      }
      match /res/{id} {
        allow read: if player();
        allow create: if player() && request.resource.data.keys().hasOnly(['by', 'r', 'g', 'w', 'ms'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.r is int && request.resource.data.r >= 1 && request.resource.data.r <= 60
          && id == string(request.resource.data.r) + '_' + request.auth.uid
          && request.resource.data.g is int && request.resource.data.g >= 1 && request.resource.data.g <= 6
          && request.resource.data.w is bool
          && request.resource.data.ms is int && request.resource.data.ms >= 0 && request.resource.data.ms <= 99999999;
      }
    }

    // daily/{day}/scores/{uid}: one score per player per Daily puzzle
    match /daily/{day}/scores/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'guesses', 'ms', 'win', 'key', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.guesses is int && request.resource.data.guesses >= 1 && request.resource.data.guesses <= 7
        && request.resource.data.win is bool
        && (request.resource.data.win == (request.resource.data.guesses <= 6))
        && request.resource.data.ms is int && request.resource.data.ms >= 0 && request.resource.data.ms <= 99999999
        && request.resource.data.key == request.resource.data.guesses * 100000000 + request.resource.data.ms
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
